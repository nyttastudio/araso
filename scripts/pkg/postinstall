#!/bin/sh
# The payload lands in a staging folder, not in /Library/Input Methods, and the files are synced
# into the existing Araso.app here, each written aside and renamed over the old one (the folder
# stays, and a running Araso keeps its old files). A first install just moves it into place.
# This was meant to avoid imklaunchagent's LaunchInputMethod -50 after an upgrade; that turned out
# to hit only ad hoc signed copies (see AGENTS.md), and the Developer ID copy starts again either way.
#
# The old Araso keeps running while that happens (no preinstall stops it: macOS would only
# start the old code again). Stop it after, then register the new copy for the logged-in user (the
# installer runs this as root) and refresh the input menu. Adding it in System Settings →
# Keyboard → Input Sources may still be needed; never fail the install.
staged="/Library/Application Support/Araso/Install/Araso.app"
app="/Library/Input Methods/Araso.app"
if [ -d "$staged" ]; then
  if [ -d "$app" ]; then
    # --checksum: a file of the same size and time must still be compared.
    if ! rsync -a --delete --checksum "$staged/" "$app/"; then
      # Part synced is a mix of old and new files under a broken seal, and the staged copy is the
      # only good one: put it in place whole, as a first install does (imklaunchagent may need a
      # logout to launch it, which beats a bundle that can't run).
      echo "Araso: syncing into $app failed; replacing it" >&2
      rm -rf "$app" && mv "$staged" "$app"
    fi
  else
    mkdir -p "/Library/Input Methods"
    mv "$staged" "$app"
  fi
  rm -rf "/Library/Application Support/Araso/Install"
  rmdir "/Library/Application Support/Araso" 2>/dev/null || true
fi
# SIGTERM, then SIGKILL whatever is left, and wait until it is gone (as vChewing's installer does):
# a Araso still running would keep the old code, and registering may start one.
pkill -x Araso 2>/dev/null || true
i=0; while pgrep -x Araso >/dev/null && [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done
pkill -9 -x Araso 2>/dev/null || true
i=0; while pgrep -x Araso >/dev/null && [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done
user=$(stat -f %Su /dev/console)
if [ -n "$user" ] && [ "$user" != root ]; then
  uid=$(id -u "$user")
  as_user() { launchctl asuser "$uid" sudo -u "$user" "$@"; }
  lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
  # Let LaunchServices take in the changed bundle first: left to --register, the update ran
  # asynchronously beside its TISRegisterInputSource, failed, and the source was gone after.
  as_user "$lsregister" -f "$app" 2>/dev/null || true
  # Then register until a fresh process sees the source (its list is cached per process).
  # A fresh process can take 10–30 s to see the source.
  i=0
  while [ $i -lt 30 ]; do
    as_user "$app/Contents/MacOS/Araso" --register || true
    as_user "$app/Contents/MacOS/Araso" --registered && break
    sleep 1; i=$((i+1))
  done
  # A copy get.sh or install.sh put in ~/Library/Input Methods is the same input method twice, and
  # macOS may launch that one: the package's copy replaces it (settings live elsewhere and stay).
  # Only after registering this copy: removed first, it takes the input source (and the user's
  # choice to use it) with it, and Araso is gone from the input menu until it is added again.
  # dscacheutil, not dscl | awk: dscl puts a home with a space on a line of its own.
  home=$(dscacheutil -q user -a name "$user" | sed -n 's/^dir: //p' | head -1)
  if [ -n "$home" ] && [ -d "$home/Library/Input Methods/Araso.app" ]; then
    as_user "$lsregister" -u "$home/Library/Input Methods/Araso.app" 2>/dev/null || true
    rm -rf "$home/Library/Input Methods/Araso.app"
  fi
  # Araso was Legato in 0.2.0 and Seamtype before it, each under its own bundle identifier: to
  # macOS other input methods, so their copies, receipts and processes go, also only after this copy
  # is registered. The settings folder moves to Araso's on the first read (SupportDirectory).
  moved=false
  for name in Legato Seamtype; do
    for old in "/Library/Input Methods/$name.app" "$home/Library/Input Methods/$name.app"; do
      if [ -d "$old" ]; then
        as_user "$lsregister" -u "$old" 2>/dev/null || true
        rm -rf "$old"
        moved=true
      fi
    done
    pkill -x $name 2>/dev/null || true
    i=0; while pgrep -x $name >/dev/null && [ $i -lt 30 ]; do sleep 0.1; i=$((i+1)); done
    pkill -9 -x $name 2>/dev/null || true
  done
  pkgutil --forget com.nyttastudio.inputmethod.Legato.pkg >/dev/null 2>&1 || true
  pkgutil --forget com.aimdevlee.inputmethod.Seamtype.pkg >/dev/null 2>&1 || true
  as_user killall TextInputMenuAgent 2>/dev/null || true
  # The switch indicator by the caret keeps the icon it read first (they ignore SIGTERM).
  as_user killall -KILL CursorUIViewService TextInputSwitcher 2>/dev/null || true
  # macOS lets no installer turn a new input method on (TISEnableInputSource answers noErr and
  # leaves it off), and to macOS Araso is new: Legato's and Seamtype's users add it once, so the pane is opened.
  if $moved; then
    as_user open "x-apple.systempreferences:com.apple.Keyboard-Settings.extension" 2>/dev/null || true
  fi
fi
exit 0
